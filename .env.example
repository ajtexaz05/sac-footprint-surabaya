# Environment Variable untuk Vercel Serverless Function
# Masukkan API Key OpenAgentic Anda pada Vercel Dashboard:
# Project Settings -> Environment Variables -> Key: SECRET_AI_API_KEY
# Base URL OpenAgentic: https://openagentic.id/api/v1
# Model: kimi-k3-1-pro (atau cek menu 'Model tersedia' di dashboard OpenAgentic)
SECRET_AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
